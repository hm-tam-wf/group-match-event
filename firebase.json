{
  "firestore": {
    "rules": "backend/firestore.rules"
  },
  "hosting": [
    {
      "site": "pickyourgroup",
      "public": "fe",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "admin.html",
        "assets/admin.css"
      ],
      "redirects": [
        { "source": "/admin.html", "destination": "https://hm-tam-wf.github.io/group-match-event/admin.html", "type": 301 },
        { "source": "/admin", "destination": "https://hm-tam-wf.github.io/group-match-event/admin.html", "type": 301 }
      ]
    },
    {
      "site": "pickyoursquad-faraday",
      "public": "hosting-redirect",
      "redirects": [
        { "source": "/", "destination": "https://pickyourgroup.web.app/", "type": 301 },
        { "source": "/:path*", "destination": "https://pickyourgroup.web.app/:path*", "type": 301 }
      ]
    }
  ]
}
