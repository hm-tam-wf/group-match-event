{
  "firestore": {
    "rules": "backend/firestore.rules"
  },
  "hosting": [
    {
      "site": "pickyourgroup",
      "public": "fe",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "admin.html",
        "assets/admin.css"
      ],
      "redirects": [
        { "source": "/admin.html", "destination": "https://pickyourgroup-admin.web.app/", "type": 302 },
        { "source": "/admin", "destination": "https://pickyourgroup-admin.web.app/", "type": 302 }
      ]
    },
    {
      "site": "pickyourgroup-admin",
      "public": "hosting-admin",
      "predeploy": ["node backend/scripts/build-admin-site.js"],
      "ignore": ["**/.*"],
      "rewrites": [
        { "source": "/", "destination": "/admin.html" }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
            { "key": "Cache-Control", "value": "no-cache" }
          ]
        }
      ]
    },
    {
      "site": "pickyoursquad-faraday",
      "public": "hosting-redirect",
      "redirects": [
        { "source": "/", "destination": "https://pickyourgroup.web.app/", "type": 301 },
        { "source": "/:path*", "destination": "https://pickyourgroup.web.app/:path*", "type": 301 }
      ]
    }
  ]
}
