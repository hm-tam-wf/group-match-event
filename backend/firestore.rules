rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.uid in ["3sY4NPL2UZPFlV4Y8q3Y3BvdT5w2", "tHN0gED97nS6KEmDBKO0SgJOiWJ3"];
    }

    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Cho dashboard liệt kê sự kiện qua collection group trên "meta"
    match /{path=**}/meta/{doc} {
      allow read: if isAdmin();
    }

    match /events/{eventId} {
      function cfg() { return get(/databases/$(database)/documents/events/$(eventId)/meta/config).data; }
      function cap() { return cfg().capacity; }
      // Sĩ số RIÊNG theo đội: meta/config.caps là map { "<emoji>": số }. Có cap riêng cho đội này ⇒ dùng nó,
      // không thì dùng sĩ số CHUNG capacity. (1 lần get qua `let` để không vượt giới hạn document-access của rules.)
      function capFor(icon) {
        let c = cfg();
        return (c.caps != null && icon in c.caps) ? c.caps[icon] : c.capacity;
      }
      // Lịch mở/đóng theo giờ: chỉ cho join trong [openAt, closeAt] (so với request.time = giờ máy chủ).
      // Field thiếu (sự kiện cũ) hoặc null ⇒ KHÔNG giới hạn phía đó. openAt/closeAt là Firestore Timestamp.
      function inWindow() {
        let c = cfg();
        return (!('openAt' in c)  || c.openAt == null  || request.time >= c.openAt)
            && (!('closeAt' in c) || c.closeAt == null || request.time <= c.closeAt);
      }

      match /meta/{doc} {
        allow read: if true;              // trang công khai cần đọc cấu hình sự kiện đang mở
        allow write: if isAdmin();        // write gồm cả delete -> admin xoá được khi xoá event
      }

      // teams: client CHỈ được "thêm đúng 1 người": tạo đội mới với 1 tên, hoặc count +1 và NỐI đúng 1 tên vào CUỐI
      // danh sách (không xoá/sửa/đảo tên cũ, không đổi icon, không thêm field) — chặn reset đội về 0 / chèn dữ liệu rác.
      // Seed, gỡ người, sửa tay là việc của admin (bỏ qua mọi ràng buộc, kể cả sĩ số riêng `caps` khi seed).
      // Tên = chuỗi 1..120 ký tự; FE chặn sớm ở NAME_MAX_LEN = 80 (fe/js/ui/ui-utils.js) — rules để rộng hơn vì cách đếm ký tự khác nhau.
      match /teams/{icon} {
        function okName(n) { return n is string && n.size() >= 1 && n.size() <= 120; }
        allow read: if true;
        allow create: if isAdmin()
                      || (exists(/databases/$(database)/documents/events/$(eventId)/meta/config)
                          && request.resource.data.keys().hasOnly(['icon', 'count', 'names'])
                          && request.resource.data.icon == icon
                          && request.resource.data.count == 1
                          && request.resource.data.names is list
                          && request.resource.data.names.size() == 1
                          && okName(request.resource.data.names[0])
                          && inWindow());                   // ngoài giờ mở/đóng ⇒ chặn join
        allow update: if isAdmin()
                      || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', 'names'])
                          && request.resource.data.count == resource.data.count + 1
                          && request.resource.data.count <= capFor(icon)
                          && request.resource.data.names is list
                          && request.resource.data.names.size() == request.resource.data.count
                          // đội đang rỗng (admin reset/gỡ người về 0) ⇒ không so tiền tố: names[0:0] làm rules báo lỗi index ⇒ chặn nhầm
                          && (resource.data.names.size() == 0 || request.resource.data.names[0:resource.data.names.size()] == resource.data.names)
                          && okName(request.resource.data.names[request.resource.data.names.size() - 1])
                          && inWindow());
        allow delete: if isAdmin();       // <-- cần để clear / xoá
      }

      match /members/{pid} {
        allow get:    if true;
        allow list:   if isAdmin();       // <-- cần để admin liệt kê khi clear
        allow create: if request.resource.data.keys().hasOnly(['icon', 'at']);
        allow update: if isAdmin();       // client KHÔNG sửa (1 người 1 đội); admin "Chuyển phòng" đổi icon trong transaction
        allow delete: if isAdmin();       // <-- cần để clear / xoá
      }

      // dedup_keys: chốt CỨNG "mỗi người chỉ chọn 1 lần" (key = _dedupKey(tên/MSNV)). `icon` (tuỳ chọn) là
      // bảng tra cứu cross-device KHÔNG PII: từ key biết đội đã chọn để máy khác hiện lại phòng/team.
      // Có `icon` ⇒ phải đi cùng một lượt join THẬT: count của teams/{icon} SAU transaction đúng bằng
      // count hiện tại + 1 (doc chưa có ⇒ coi như 0) ⇒ không ghi icon tuỳ ý khi không join.
      // Nhánh {at} (không icon, cho FE cũ) ĐÃ BỎ 2026-11-10 (phase B): ai cũng tạo được {at} ⇒ khoá trước mã/tên người khác.
      match /dedup_keys/{key} {
        allow get:    if true;
        allow list:   if isAdmin();       // <-- cần để admin liệt kê khi clear
        allow create: if isAdmin()
                      || (request.resource.data.keys().hasOnly(['at', 'icon'])
                          && request.resource.data.icon is string
                          && getAfter(/databases/$(database)/documents/events/$(eventId)/teams/$(request.resource.data.icon)).data.count
                             == (exists(/databases/$(database)/documents/events/$(eventId)/teams/$(request.resource.data.icon))
                                  ? get(/databases/$(database)/documents/events/$(eventId)/teams/$(request.resource.data.icon)).data.count
                                  : 0) + 1);
        allow update: if isAdmin();       // client KHÔNG ghi đè khoá; admin "Chuyển phòng" cập nhật icon (k1 / m~)
        allow delete: if isAdmin();       // <-- cần để clear / xoá
      }

      // Đặt-chỗ TIỀN-JOIN: giữ MSNV NGAY khi điền form để KHÔNG tạo signup thứ hai cùng mã (trước cả khi
      // join). key = _dedupKey(<dedupField>) — chuẩn hoá GIỐNG dedup_keys. Doc chỉ { at } (KHÔNG chứa pid
      // → không lộ token dù key = MSNV dễ đoán). Chốt CỨNG vẫn là dedup_keys (ghi lúc JOIN); đây là chốt mềm.
      match /reg_keys/{key} {
        allow get:    if true;            // client transaction + cổng vào đọc theo key đã biết
        allow list:   if isAdmin();       // chỉ admin liệt kê khi clear; KHÔNG mở cho client (chống enumerate)
        // create: hold "trần" {at} (apiRegReserve), HOẶC trực tiếp {profiled} khi lưu hồ sơ mà chưa có hold.
        allow create: if request.resource.data.keys().hasOnly(['at'])
                      || (request.resource.data.keys().hasOnly(['profiled']) && request.resource.data.profiled == true);
        // update CHỈ để gắn cờ `profiled=true` (đã có signup THẬT cho MSNV) — KHÔNG cho đụng 'at' hay thêm field
        // khác. Cổng/đặt-chỗ chỉ chặn khi profiled=true ⇒ hold bỏ dở không khoá nhầm. (xem apiSaveProfile)
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['profiled'])
                      && request.resource.data.profiled == true;
        // delete tự do: chủ đặt-chỗ TỰ NHẢ khi đổi/sửa MSNV (typo) để không khoá nhầm mã người khác. Stakes
        // thấp: chỉ chốt tiền-join; xoá chỗ chỉ "mở lại" mã (= như chưa giữ), không đụng dedup_keys/signups.
        allow delete: if true;
      }

      // Danh sách cho phép (allowlist): chỉ key có trong đây mới claim được khi meta/config.allowlistMode = true.
      // key = _dedupKey(<giá trị dedupField>) — chuẩn hoá GIỐNG HỆT dedup_keys để import & claim khớp tuyệt đối.
      match /allowlist/{key} {
        allow get:   if true;             // client transaction cần đọc theo key đã biết
        allow list:  if isAdmin();        // chỉ admin liệt kê/đếm; KHÔNG mở cho client (chống enumerate)
        allow write: if isAdmin();        // admin import từ Excel; client không ghi
      }

      // signups: client ghi/xoá hồ sơ CỦA CHÍNH MÌNH — an toàn nhờ signups KHOÁ ĐỌC + pid là token ngẫu nhiên ("u…")
      // nên không ai enumerate/đoán được pid người khác. NGOẠI LỆ: người được admin XẾP SẴN có pid TẤT ĐỊNH
      // "seed_<khoá>" (admin seedTeams + backend/scripts/tnt-import.js — để seed lại không nhân bản) ⇒ đoán được ⇒
      // chỉ admin được ghi/xoá doc seed_*. `icon` (nếu có) phải là chuỗi: admin sắp xếp/hiển thị bảng theo nó.
      match /signups/{pid} {
        function ownDoc()  { return !pid.matches('seed_.*'); }
        function okShape() { return !('icon' in request.resource.data) || request.resource.data.icon is string; }
        allow read:   if isAdmin();       // (list/count cho admin)
        // create: ghi hồ sơ NGAY khi điền xong (kể cả CHƯA chọn đội); playerId phải đúng pid của doc.
        allow create: if isAdmin() || (ownDoc() && request.resource.data.playerId == pid && okShape());
        // update: gắn đội khi join / sửa lại hồ sơ của chính mình — GIỮ NGUYÊN playerId (không đổi danh tính bản ghi).
        allow update: if isAdmin() || (ownDoc() && request.resource.data.playerId == resource.data.playerId && okShape());
        // delete: chủ bản ghi TỰ DỌN signup trùng của mình khi MSNV hoá ra đã có người join (đụng độ pre-join).
        allow delete: if isAdmin() || ownDoc();
      }
    }

    match /{document=**} { allow read, write: if false; }
  }
}