# Cache deploy của Firebase CLI (local hosting cache) — không commit
.firebase/

# Dữ liệu BTC (họ tên nhân sự thật, tài liệu nội bộ) — KHÔNG đưa lên git (repo public)
btc-data/

# Đầu ra của bộ test (log emulator, kết quả JSON, bản admin dựng tạm, ảnh smoke) — không commit
tests/.out/

# Site admin riêng dựng tự động trước khi deploy (backend/scripts/build-admin-site.js, predeploy trong firebase.json)
hosting-admin/
